generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id         Int         @id @default(autoincrement())
  nombre     String      @db.VarChar(100)
  apellido   String      @db.VarChar(100)
  correo     String      @unique @db.VarChar(255)
  password   String      @db.VarChar(255)
  rol        String      @default("USER") @db.VarChar(50)
  verificado Boolean?    @default(false)
  Compra     Compra[]
  Mi_Carrito Mi_Carrito?
  Resenia    Resenia[]
  favorito   favorito[]
}

model Producto {
  id                Int                @id @default(autoincrement())
  nombre            String
  descripcion       String
  miniDescripcion   String             @db.VarChar(50)
  duracion          String             @db.VarChar(50)
  material          String             @db.VarChar(100)
  alto              Float?
  ancho             Float?
  mililitros        Float?
  fechaCreacion     DateTime           @default(now()) @db.Timestamp(6)
  estadoProducto    String             @default("DISPONIBLE") @db.VarChar(100)
  premium           Boolean?           @default(false)
  idTipoProducto    Int
  puntuacionTotal   Float?             @default(0)
  cantidadResenias  Int?               @default(0)
  ImagenProducto    ImagenProducto[]
  Tipo_de_productos Tipo_de_productos  @relation(fields: [idTipoProducto], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_tipo_producto")
  Resenia           Resenia[]
  VarianteProducto  VarianteProducto[]
  favorito          favorito[]
}

model Aroma {
  id               Int                @id @default(autoincrement())
  aroma            String             @unique
  VarianteProducto VarianteProducto[]
}

model Tipo_de_productos {
  id       Int        @id @default(autoincrement())
  tipo     String     @db.VarChar(100)
  Producto Producto[]
}

model ImagenProducto {
  id         Int      @id @default(autoincrement())
  url        String   @db.VarChar(255)
  idProducto Int
  Producto   Producto @relation(fields: [idProducto], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_producto")
}

model Mi_Carrito {
  id                  Int                   @id(map: "mi_carrito_pkey") @default(autoincrement())
  idUsuario           Int                   @unique(map: "uq_mi_carrito_usuario")
  Usuario             Usuario               @relation(fields: [idUsuario], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_mi_carrito_usuario")
  Mi_Carrito_Producto Mi_Carrito_Producto[]
}

model Mi_Carrito_Producto {
  id               Int              @id @default(autoincrement())
  idCarrito        Int
  idVariante       Int
  cantidad         Int              @default(1)
  Mi_Carrito       Mi_Carrito       @relation(fields: [idCarrito], references: [id], onDelete: Cascade, onUpdate: NoAction)
  VarianteProducto VarianteProducto @relation(fields: [idVariante], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([idCarrito, idVariante], map: "mi_carrito_producto_unique")
}

model favorito {
  id         Int      @id @default(autoincrement())
  idUsuario  Int
  idProducto Int
  Producto   Producto @relation(fields: [idProducto], references: [id], onDelete: Cascade, onUpdate: NoAction)
  Usuario    Usuario  @relation(fields: [idUsuario], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([idUsuario, idProducto], map: "favorito_producto_unique")
}

model Compra {
  id              Int               @id @default(autoincrement())
  idUsuario       Int
  estado          String            @default("CREADA") @db.VarChar(30)
  paymentId       String?           @db.VarChar(100)
  total           Float             @default(0)
  fecha           DateTime          @default(now()) @db.Timestamp(6)
  Usuario         Usuario           @relation(fields: [idUsuario], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Producto_Compra Producto_Compra[]
}

model Producto_Compra {
  id               Int              @id @default(autoincrement())
  idVariante       Int
  cantidad         Int              @default(1)
  idCompra         Int
  Compra           Compra           @relation(fields: [idCompra], references: [id], onDelete: NoAction, onUpdate: NoAction)
  VarianteProducto VarianteProducto @relation(fields: [idVariante], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model Resenia {
  id           Int      @id @default(autoincrement())
  idUsuario    Int
  idProducto   Int
  calificacion Int
  comentario   String?
  fecha        DateTime @default(now()) @db.Timestamp(6)
  Producto     Producto @relation(fields: [idProducto], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Usuario      Usuario  @relation(fields: [idUsuario], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model VarianteProducto {
  id                  Int                   @id @default(autoincrement())
  idProducto          Int
  idAroma             Int
  precio              Float
  stock               Int
  sku                 String                @unique
  estado              String                @default("DISPONIBLE")
  Mi_Carrito_Producto Mi_Carrito_Producto[]
  Producto_Compra     Producto_Compra[]
  Producto            Producto              @relation(fields: [idProducto], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "aroma_producto_fk")
  Aroma               Aroma                 @relation(fields: [idAroma], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "producto_aroma_fk")

  @@unique([idProducto, idAroma], map: "variante_producto_unique")
}
