{
  "compilerOptions": {
    "module": "esnext",
    "target": "es2020",
    "moduleResolution": "bundler",

    "rootDir": "./src",
    "outDir": "./dist",

    "sourceMap": true,

    "strict": true,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "isolatedModules": true
  },
  "include": ["src"]
}
